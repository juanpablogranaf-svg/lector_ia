<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme used for splash screen -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <!-- NormalTheme used by Flutter embedding -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/normal_background</item>
    </style>
    <color name="launch_background">#FF6200EE</color>
    <color name="normal_background">#FFFFFFFF</color>
</resources>
